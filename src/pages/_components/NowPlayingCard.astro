---
import Label from "@components/Label.astro"
import MusicIcon from "@assets/music.svg"
---

<div class="np-card" id="now-playing">
    <MusicIcon class="np-art-placeholder" mode="inline"/>
    <img class="np-art" crossorigin="anonymous" draggable="false" alt=""/>
    <span class="np-art-gradient"/>

    <div class="np">
        <Label style="color: var(--np-accent)">Listening To</Label>

        <div class="np-info">
            <p class="np-song"/>
            <p class="np-artist"/>
        </div>
    </div>
</div>

<script>
    import { isDarkTheme } from "@scripts/theme";
    import { getThemeFromImage } from "@scripts/color";
    import { DEFAULT_IMAGE_ID, getNowPlaying } from "@scripts/lastfm";
    import { hexFromArgb } from "@material/material-color-utilities";

    const card   = document.getElementsByClassName("np-card")[0]   as HTMLDivElement
    const art    = document.getElementsByClassName("np-art")[0]    as HTMLImageElement
    const song   = document.getElementsByClassName("np-song")[0]   as HTMLParagraphElement
    const artist = document.getElementsByClassName("np-artist")[0] as HTMLParagraphElement

    let updateNowPlaying = () => getNowPlaying().then(track => {
        card.style.setProperty("display", track ? "flex" : "none"); // Card is invisible by default to prevent flashing on page load
        if (!track) return;

        song.innerText = track.name;
        artist.innerText = track.artist["#text"];

        let artUrl = track.image[3]["#text"];
        art.style.setProperty("display", artUrl.includes(DEFAULT_IMAGE_ID) ? "none" : "block");
        art.src = artUrl;
        
        // The 'Now Playing' card uses colors based on the album art of the current song
        getThemeFromImage(art).then(theme => { 
            const colorScheme = isDarkTheme() ? theme.schemes.dark : theme.schemes.light;

            card.style.setProperty("--np-background", hexFromArgb(colorScheme.primaryContainer))
            card.style.setProperty("--np-accent", hexFromArgb(colorScheme.primary))
            card.style.setProperty("--np-text", hexFromArgb(colorScheme.onPrimaryContainer))
        }).catch(e => console.error(e));
    })

    setInterval(updateNowPlaying, 10_000)
    updateNowPlaying()
</script>

<style lang="scss">
    .np-card {
        display: none;
        flex-direction: column;
        border-radius: 24px;
        background-color: var(--np-background);
        height: min-content;
        width: 100%;
        z-index: -2;
        anchor-name: --np-card;

        --np-background: var(--container);
        --np-accent: var(--onSurfaceAlt);
        --np-text: var(--primary);

        .np-art, .np-art-placeholder, .np-art-gradient {
            position: absolute;
            position-anchor: --np-card;
            right: anchor(right);
            z-index: -1;
            height: anchor-size();
            width: min-content;
            aspect-ratio: 1 / 1;
            border-radius: 0 24px 24px 0;
            color: var(--np-accent);
        }

        .np-art-gradient {
            background: linear-gradient(90deg, var(--np-background) 5%, transparent);
            aspect-ratio: 1.01 / 1; // Making the gradient a tiny bit wider reduces some artifacts (was most noticible in light mode)
        }

        .np {
            display: flex;
            flex-direction: column;
            gap: 0.8em;
            padding: 24px;
            z-index: 1;

            .np-info {
                display: flex;
                flex-direction: column;
                gap: 0.3em;
                overflow: hidden;
                margin-top: 0.8em;

                .np-song, .np-artist {
                    font-size: 12px;
                    margin: 0;
                    color: var(--np-text);
                    overflow: hidden;
                    white-space: nowrap;
                    text-overflow: ellipsis;
                }

                .np-song {
                    font-size: 18px;
                    font-weight: bold;
                }
            }
        }
    }
</style>