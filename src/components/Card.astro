---
import type { HTMLAttributes } from 'astro/types'

export type Props = HTMLAttributes<"div">
---

<div {...Astro.props}>
    <slot />
</div>

<style>
    div {
        display: flex;
        flex-direction: column;
        border-radius: 24px;
        background-color: var(--container);
        padding: 24px;
    }
</style>